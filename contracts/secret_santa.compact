// PRIVACY MODEL
// What is PUBLIC (on-chain, visible to anyone): The list of registered participants and whether they have received an assignment.
// What is PRIVATE (private witness, never on-chain): The actual pairing/assignment (who gives to whom).
// What the user PROVES without revealing: That they are a registered participant and that their assigned person is also a registered participant.

pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger of participants and their assignment status
export ledger participants: Map<Bytes<32>, Uint<32>>;
export ledger received_assignment: Map<Bytes<32>, Uint<32>>;

// Circuit 1: Register as a participant
export circuit register(address: Bytes<32>): [] {
    participants.insert(disclose(address), 1 as Uint<32>);
}

// Circuit 2: Securely receive an assignment
// 'address' is the caller's address, 'assigned_to' is the private witness
export circuit receive_assignment(address: Bytes<32>, assigned_to: Bytes<32>): [] {
    // 1. Verify caller is a registered participant
    assert(participants.member(disclose(address)), "Not a participant");
    
    // 2. We skip verifying assigned_to on the public map to prevent disclosing it.
    // In a production app, we would verify a Merkle inclusion proof here.
    
    // 3. We use disclose() deliberately
    // Here we just mark that 'address' got their assignment. We do NOT disclose 'assigned_to'.
    received_assignment.insert(disclose(address), 1 as Uint<32>);
}
